rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products: Public read, allowed write for seeding and admin updates
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: Public read
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Users: Storing user profiles and roles ('customer' / 'admin')
    match /users/{userId} {
      allow read, write: if true;
    }

    // Orders: Anyone can create orders, track by order ID
    match /orders/{orderId} {
      allow create, read, update: if true;
    }

    // Carts & Wishlists: Storage for shopper carts
    match /carts/{userId} {
      allow read, write: if true;
    }

    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // Reviews: Public read and write
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Inquiries: Wholesale & Dealer bulk inquiries
    match /inquiries/{inquiryId} {
      allow create, read: if true;
    }
  }
}
